{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/v3-esc-guard.py",
            "timeout": 15,
            "statusMessage": "Garde esc() v3"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/backend-typecheck.sh",
            "timeout": 120,
            "statusMessage": "tsc --noEmit backend"
          }
        ]
      }
    ]
  }
}
